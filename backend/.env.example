# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/vocalize?retryWrites=true&w=majority

# Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-admin-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nUN-ESCAPED-PRIVATE-KEY\n-----END PRIVATE KEY-----\n"
